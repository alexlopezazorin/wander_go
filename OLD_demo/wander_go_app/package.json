{
  "name": "wander-go-app",
  "version": "1.0.0",
  "description": "Unified WanderGo project",
  "main": "index.js",
  "scripts": {
    "dev:backend": "cd backend && python -m uvicorn app.main:app --reload --port 8000",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
